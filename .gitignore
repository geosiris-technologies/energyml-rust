# --- Rust ------------------------------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb
# Reference packages and the Lutetia model are fetched into target/ by the scripts, never committed.
# A local corpus to test against, if any, lives here and stays local.
/testdata/

# Python packaging output, at the root and in the Python crate only: a bare `build/` would also hide
# Rust sources (`crates/energyml-rules/build/`, a `tests/build/` module).
/dist/
/build/
crates/energyml-python/dist/
crates/energyml-python/build/
*.whl
*.so
*.pyd
*.dylib

# WebAssembly build output
/pkg/
*.wasm

# The documentation book, built by CI
/docs/book/

# --- Local state that no repository of this family ever commits ---------------------------
# Secrets
.env
.env.*
*.token
*.key
*.pem
*.p12
*.pfx
secrets/

# Editors, and the local settings of AI assistants
.idea/
.vscode/
.fleet/
.zed/
*.swp
*~
.claude/
CLAUDE.local.md

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Merge and backup leftovers
*.orig
*.rej
*.bak

# Logs, profiles and coverage
*.log
*.profraw
perf.data*
lcov.info
coverage/
htmlcov/
.coverage

# Python tooling (scripts, the Python bridge, fixture generators)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
