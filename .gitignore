# Rust
/target/
**/*.rs.bk
# Libraries commit Cargo.lock only if the workspace ships binaries; this one does.

# Fixtures fetched by scripts/fetch-fixtures.py (never committed)
/target/fixtures/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Python packaging output, at the root and in the Python crate only: a bare `build/`
# would also hide Rust sources (`crates/energyml-rules/build/`, a `tests/build/` module).
/dist/
/build/
crates/energyml-python/dist/
crates/energyml-python/build/
*.whl
# maturin build products
*.so
*.pyd
*.dylib

# WebAssembly
pkg/
*.wasm

# Documentation build
/docs/book/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local output
*.log
.env
.env.*
